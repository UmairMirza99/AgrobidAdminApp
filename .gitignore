# --- Flutter / Dart build output (regenerated by `flutter pub get` / `flutter build`) ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
.widget_preview/
migrate_working_dir/

# Generated platform folders for platforms this web-only app doesn't use
/android/
/ios/
/linux/
/macos/
/windows/

# Symbols and obfuscation maps
app.*.symbols
app.*.map.json

# --- Secrets: never commit keys, passwords or local environment files ---
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
key.properties
secrets.json

# --- Editors and IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history
*.swp

# --- OS and tool clutter ---
.DS_Store
Thumbs.db
desktop.ini
*.log
*.class
*.pyc
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
